      },
      "selected_scope_digest": {
        "type": "string",
        "min_length": 1,
        "pattern": "^[0-9a-f]{64}$",
        "semantics": "SHA-256 lowercase hex over the RFC 8785 canonical JSON of the selected three-ring scope recorded in the retained bundle"
      },
      "bundle_digest": {
        "type": "string",
        "min_length": 1,
        "pattern": "^[0-9a-f]{64}$",
        "semantics": "Exact bundle_digest from the retained evidence bundle"
      },
      "test_side_commits": {
        "type": "array",
        "items": {
          "type": "string",
          "min_length": 1,
          "pattern": "^[0-9a-f]{40,64}$"
        },
