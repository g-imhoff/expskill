            "path": {
              "type": "string",
              "min_length": 1
            },
            "sha256": {
              "type": "string",
              "min_length": 1,
              "pattern": "^[0-9a-f]{64}$",
              "semantics": "SHA-256 lowercase hex over the retained artifact bytes"
            }
          }
        },
        "min_items": 0,
        "unique_items": false
      },
      "teardown": {
