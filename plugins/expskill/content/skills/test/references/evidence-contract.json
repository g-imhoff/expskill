        },
        "min_items": 0,
        "unique_items": false
      },
      "result": {
        "type": "string",
        "min_length": 1,
        "enum": [
          "PASS",
          "FAIL",
          "BLOCKED",
          "EXEMPT"
        ]
      },
      "bundle_digest": {
        "type": "string",
        "min_length": 1,
        "pattern": "^[0-9a-f]{64}$",
        "semantics": "SHA-256 lowercase hex over the RFC 8785 canonical JSON of the complete bundle with only the bundle_digest field omitted"
      },
      "started_at": {
        "type": "string",
        "min_length": 1,
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.+-]+Z$"
      },
      "completed_at": {
        "type": "string",
        "min_length": 1,
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.+-]+Z$"
      }
    }
