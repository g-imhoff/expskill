  "receipt": {
    "type": "object",
    "additional_properties": false,
    "required": [
      "schema_version",
      "run_id",
      "workflow_id",
      "repository",
      "branch",
      "head",
      "environment_digest",
      "selected_scope_digest",
      "bundle_digest",
